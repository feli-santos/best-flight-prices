# syntax=docker/dockerfile:1
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN ./gradlew :fake-provider:installDist --no-daemon -q

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 bfp
COPY --from=build /src/fake-provider/build/install/fake-provider/ /app/
USER 10001
ENV FAKE_PORT=8090
EXPOSE 8090
ENTRYPOINT ["/app/bin/fake-provider"]
